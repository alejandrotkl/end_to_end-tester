# Настройки API-сервера (src/server.ts).
# Скопируйте этот файл в .env и заполните своими значениями — .env в Git не попадает.

# Порт, на котором поднимается сервер.
PORT=3000

# Обязательный список API-ключей клиентов в формате "имя:ключ", через запятую.
# Каждый клиент/команда получает свой ключ и передаёт его в заголовке
# X-API-Key (или Authorization: Bearer <ключ>) при обращении к /api/v1/*.
# Ключи придумывайте длинными и случайными, например: openssl rand -hex 32
API_KEYS=team-a:CHANGE_ME_LONG_RANDOM_KEY,team-b:CHANGE_ME_ANOTHER_KEY

# Сколько задач (прогонов Playwright) может выполняться одновременно.
# Прогоны используют браузер и сеть, поэтому по умолчанию — только один за раз.
MAX_CONCURRENT_JOBS=1

# Максимум ссылок в одной задаче — защита от случайной перегрузки сервера.
MAX_LINKS_PER_JOB=500

# Максимальный размер запроса на создание задачи (в байтах) — и для
# загружаемого файла со ссылками, и для JSON-тела с массивом links.
MAX_UPLOAD_BYTES=2097152

# Папка, где сервер хранит данные задач (вход/лог/результат каждой — в своей
# подпапке) и индекс всех задач. Можно вынести на отдельный диск/том.
JOBS_DIR=.jobs

# Интервал плановых проверок по умолчанию (в миллисекундах), если клиент не
# указал свой intervalMinutes при настройке расписания (PUT /api/v1/schedule).
# 300000 мс = 5 минут.
SCHEDULE_INTERVAL_MS=300000

# Сколько дней хранить логи/результаты завершённых задач в JOBS_DIR, прежде
# чем сервер удалит их автоматически. Актуально в первую очередь для плановых
# проверок — они создают новую задачу на каждый запуск (например, каждые
# 5 минут), и без очистки папка JOBS_DIR будет расти бесконечно.
LOG_RETENTION_DAYS=30

# Как часто сервер проверяет, не пора ли удалить устаревшие логи (в мс).
# 86400000 мс = 1 сутки — раз в сутки достаточно, срок хранения при этом
# соблюдается с точностью до суток, а не «плюс-минус» из-за перезапусков.
CLEANUP_INTERVAL_MS=86400000

# Папка, где хранятся данные для входа по доменам (используются, когда
# ссылка отвечает HTTP 403) — отдельный файл на каждый API-ключ. Настраиваются
# через PUT /api/v1/credentials/:domain или веб-интерфейс, не через .env.
CREDENTIALS_DIR=.credentials

# Папка, где хранится общий черновик списка ссылок веб-интерфейса (отдельный
# файл на каждый API-ключ) — так пользователи с разных устройств видят один
# и тот же список и правки друг друга. Настраивается через веб-интерфейс,
# не через .env.
DRAFTS_DIR=.jobs/drafts
